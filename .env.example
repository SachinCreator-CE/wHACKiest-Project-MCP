# SentinelAI configuration. Copy to .env (never commit .env) and fill in.
# This file must never contain a real secret or a real access key ID.

# --- Mode -------------------------------------------------------------------
# auto    = use AWS when credentials work, otherwise the offline fallback (default)
# aws     = same as auto, but the UI flags missing/broken AWS as an error (red AWS pill + banner)
# offline = never touch AWS or the network (demo backup / CI)
# (off/false/demo mean offline, live/true mean aws; any other value falls back to offline.)
SENTINEL_MODE=auto

# --- AWS core ---------------------------------------------------------------
# boto3 default credential chain. Locally this is the sentinel-app CLI profile;
# on EC2 delete (or comment out) the AWS_PROFILE line to use the instance role. Never put keys here.
AWS_PROFILE=sentinel-app
AWS_REGION=ap-south-1
# (AWS_DEFAULT_REGION is used when AWS_REGION is empty.)
# Comma separated (region names are validated; invalid entries are ignored). IAM/STS events land in us-east-1 Event history, so keep it.
# Empty = "<AWS_REGION>,us-east-1".
CLOUDTRAIL_REGIONS=ap-south-1,us-east-1
# Hours, 1..2160 (CloudTrail Event history keeps 90 days). Invalid, 0 or negative values fall back to 24.
# Keep it >= 3: the offline demo scenario spans the last ~3 h (a shorter window warns and loses incidents).
CLOUDTRAIL_LOOKBACK_HOURS=24
CLOUDTRAIL_CACHE_TTL_S=60
# AWS Labs CloudTrail MCP server (needs uv: brew install uv). The app falls back to boto3 without it.
# Pinned to the tested version; it only receives AWS_*/PATH/HOME/proxy/uv env vars, never the app's secrets.
CLOUDTRAIL_MCP_COMMAND=uvx awslabs.cloudtrail-mcp-server@0.1.2

# --- Bedrock ----------------------------------------------------------------
# Empty = AWS_REGION.
BEDROCK_REGION=ap-south-1
# Nova Lite through the APAC inference profile (us.amazon.nova-lite-v1:0 in us-east-1).
# One-line switch to a stronger model: apac.amazon.nova-pro-v1:0 (or any profile listed by
# scripts/list_bedrock_models.py; re-render the IAM policy after changing it).
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1200
BEDROCK_MAX_TURNS=6
# Seconds one copilot question may spend on Bedrock (all rounds) before the offline answer is used (5-300).
BEDROCK_DEADLINE_S=45
# Optional Bedrock Guardrail (second masking layer). Re-render the IAM policy after setting.
# The guardrail ID (e.g. abc123xyz0) or ARN, not its name. Version: DRAFT (default) or a number.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- S3 / CloudWatch Logs -----------------------------------------------------
# Empty = scripts/aws_setup.py generates sentinelai-<8 hex> and writes it here.
S3_BUCKET=
AUTH_LOG_GROUP=/sentinelai/app-auth

# --- Live INC-001 -------------------------------------------------------------
# The access key ID (AKIA..., NOT the secret) of the zero-permission sentinel-demo-victim user.
# Leave empty for the synthetic offline scenario.
DEMO_LEAKED_ACCESS_KEY_ID=
DEMO_VICTIM_USER=sentinel-demo-victim
# ISO time the synthetic GitHub alert "flagged" the key, e.g. 2026-11-24T10:00:00+05:30 or 2026-11-24T04:30:00Z.
# No offset = UTC (warned: a local time written without its offset lands hours off), or a relative time such
# as "2 hours ago". Empty, invalid or in the future = start of the lookback window.
DEMO_LEAK_FLAGGED_AT=

# --- Real remediation guard rails ----------------------------------------------
# Only when true (and a human approves, the user is allow-listed, the incident is live
# and AWS is connected) does "Deactivate leaked access key" call iam:UpdateAccessKey.
ALLOW_REAL_ACTIONS=false
REAL_ACTION_USER_ALLOWLIST=sentinel-demo-victim

# --- ElevenLabs voice (optional; the browser Web Speech API is the fallback) ---------
ELEVENLABS_API_KEY=
# Or keep the key in AWS Secrets Manager (secret name must start with sentinelai/elevenlabs).
ELEVENLABS_SECRET_ID=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Local paths (empty = ./data and ./var) -------------------------------------
SENTINEL_DATA_DIR=
SENTINEL_VAR_DIR=

# --- Server (python -m sentinel; --host/--port/--log-level override) ---------------
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=info
